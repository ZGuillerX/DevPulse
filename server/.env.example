# Servidor
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Base de datos
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=devpulse
DB_PORT=3306

# Auth
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# Cifrado de tokens de GitHub guardados en DB (32 bytes en hex)
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# GitHub OAuth App — regístrala en https://github.com/settings/developers
# Authorization callback URL debe coincidir EXACTAMENTE con GITHUB_CALLBACK_URL
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# Webhook — configúralo en Settings > Webhooks del repo, con una URL pública
# (ej. mediante ngrok en desarrollo, o tu dominio en producción)
GITHUB_WEBHOOK_SECRET=

# IA (opcional, el usuario también puede pasar su propia key desde el frontend)
GROQ_API_KEY=
OPENAI_API_KEY=

# Alertas por email (opcional) — regístrate gratis en https://resend.com,
# crea una API key en resend.com/api-keys. Sin dominio propio verificado,
# solo podrás enviar a la dirección con la que te registraste en Resend.
RESEND_API_KEY=
ALERT_EMAIL_FROM=DevPulse <onboarding@resend.dev>

# Rate limiting propio
RATE_LIMIT_PER_MINUTE=100

# Caché
CACHE_TTL_SECONDS=120

# Sync periódico
SYNC_INTERVAL_MINUTES=15

LOG_LEVEL=info
